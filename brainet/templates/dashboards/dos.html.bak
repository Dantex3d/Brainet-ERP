
{% extends 'dashboards/base.html' %}
{% load static %}

{% block content %}

<div class="container-fluid py-4">

    <!-- ================= TOPBAR ================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                <!-- LEFT -->
                <div class="d-flex align-items-center gap-3">

                    {% if school.logo %}
                        <img src="{{ school.logo.url }}"
                             width="60"
                             height="60"
                             class="rounded-circle shadow">
                    {% else %}
                        <img src="{% static 'images/school.png' %}"
                             width="60"
                             height="60"
                             class="rounded-circle shadow">
                    {% endif %}

                    <div>
                        <h4 class="fw-bold text-primary mb-0">
                            {{ school.name }}
                        </h4>

                        <small class="text-muted">
                            Director of Studies Portal
                        </small>
                    </div>

                </div>

                <!-- RIGHT -->
                <div class="d-flex flex-wrap gap-2 align-items-center">

                    <button class="btn btn-primary rounded-3"
                            onclick="window.location.reload();">
                        🔄 Refresh
                    </button>

                    <a href="{% url 'manage_subjects' %}"
                       class="btn btn-outline-dark rounded-3">
                        📘 Subjects
                    </a>

                    <a href="{% url 'manage_terms' %}"
                       class="btn btn-outline-primary rounded-3">
                        📅 Terms
                    </a>

                    <a href="{% url 'request_voucher' %}"
                       class="btn btn-outline-success rounded-3">
                        💳 Request Voucher
                    </a>

                    <!-- Notifications -->
                    <div class="dropdown">

                        <button class="btn btn-light border position-relative"
                                data-bs-toggle="dropdown">

                            🔔

                            {% if unread_messages > 0 %}
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                {{ unread_messages }}
                            </span>
                            {% endif %}

                        </button>

                        <div class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-3"
                             style="width:350px;">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <h6 class="fw-bold mb-0">
                                    Notifications
                                </h6>

                                <a href="{% url 'clear_notifications' %}"
                                   class="btn btn-sm btn-outline-danger">
                                    Clear
                                </a>

                            </div>

                            {% for n in dos_messages|slice:":5" %}

                            <div class="border-bottom pb-2 mb-2">

                                <div class="fw-semibold text-primary">
                                    {{ n.subject|default:"Message" }}
                                </div>

                                <small class="text-muted">
                                    {{ n.message|truncatechars:60 }}
                                </small>

                            </div>

                            {% empty %}

                            <div class="text-muted text-center py-3">
                                No notifications
                            </div>

                            {% endfor %}

                        </div>

                    </div>

                    <a href="{% url 'logout' %}"
                       class="btn btn-danger rounded-3">
                        Logout
                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- ================= STATS ================= -->
    <div class="row g-4 mb-4">

        <div class="col-lg-3 col-md-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Students
                    </small>

                    <h2 class="fw-bold text-primary">
                        {{ students|length }}
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Classes
                    </small>

                    <h2 class="fw-bold text-success">
                        {{ classes|length }}
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Subjects
                    </small>

                    <h2 class="fw-bold text-warning">
                        {{ subjects|length }}
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Exam Window
                    </small>

                    <h2 class="fw-bold text-danger">
                        OPEN
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- ================= NAVIGATION BAR ================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="row g-2">

                <div class="col-lg-2 col-md-4 col-sm-6">
                    <a href="{% url 'manage_students' %}"
                       class="btn btn-outline-primary w-100 btn-sm rounded-3">
                        👨‍🎓 Students
                    </a>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6">
                    <a href="{% url 'manage_teachers' %}"
                       class="btn btn-outline-success w-100 btn-sm rounded-3">
                        🧑‍🏫 Teachers
                    </a>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6">
                    <a href="{% url 'manage_classes' %}"
                       class="btn btn-outline-warning w-100 btn-sm rounded-3">
                        🏫 Classes
                    </a>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6">
                    <a href="{% url 'manage_subjects' %}"
                       class="btn btn-outline-dark w-100 btn-sm rounded-3">
                        📘 Subjects
                    </a>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6">
                    <a href="{% url 'enter_marks' %}"
                       class="btn btn-outline-danger w-100 btn-sm rounded-3">
                        📊 Marks
                    </a>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6">
                    <a href="{% url 'manage_exams' %}"
                       class="btn btn-outline-info w-100 btn-sm rounded-3">
                        📝 Exams
                    </a>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6">
                    <a href="{% url 'marksheet_center' %}"
                       class="btn btn-outline-secondary w-100 btn-sm rounded-3">
                        📂 Marksheet
                    </a>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6">
                    <a href="{% url 'manage_grading' %}"
                       class="btn btn-outline-success w-100 btn-sm rounded-3">
                        ⭐ Grading
                    </a>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6">
                    <a href="{% url 'report_center' %}"
                       class="btn btn-outline-dark w-100 btn-sm rounded-3">
                        📄 Reports
                    </a>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6">
                    <a href="{% url 'manage_terms' %}"
                       class="btn btn-outline-primary w-100 btn-sm rounded-3">
                        📅 Terms
                    </a>
                </div>

            </div>

        </div>

    </div>

    <!-- ================= ACADEMIC CONTROLS ================= -->
    <div class="row">

        <!-- MAIN -->
        <div class="col-lg-12">

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-header bg-success text-white rounded-top-4">

                    <h5 class="mb-0">
                        Examination Controls
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <form method="post"
                                  action="{% url 'open_exam_window' %}">

                                {% csrf_token %}

                                <button class="btn btn-success w-100 py-3">
                                    ✅ Open Exams
                                </button>

                            </form>

                        </div>

                        <div class="col-md-6">

                            <form method="post"
                                  action="{% url 'close_exam_window' %}">

                                {% csrf_token %}

                                <button class="btn btn-danger w-100 py-3">
                                    ❌ Close Exams
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

            <!-- MESSAGE CENTER -->
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-dark text-white rounded-top-4 d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">
                        📨 DOS Inbox
                    </h5>

                    <a href="{% url 'clear_notifications' %}"
                       class="btn btn-sm btn-outline-light">
                        Clear All
                    </a>

                </div>

                <div class="card-body">

                    {% for msg in dos_messages %}

                    <div class="border rounded-4 p-3 mb-3">

                        <div class="d-flex justify-content-between flex-wrap gap-2">

                            <div>

                                <h6 class="fw-bold text-primary">
                                    {{ msg.subject }}
                                </h6>

                                <p class="mb-2">
                                    {{ msg.message }}
                                </p>

                                <small class="text-muted">
                                    {{ msg.created_at }}
                                </small>

                            </div>

                            <div>

                                {% if msg.status == "replied" %}
                                    <span class="badge bg-success">
                                        Replied
                                    </span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                {% endif %}

                            </div>

                        </div>

                        <form method="post"
                              action="{% url 'reply_message' msg.id %}"
                              class="mt-3">

                            {% csrf_token %}

                            <div class="input-group">

                                <input type="text"
                                       name="message"
                                       class="form-control"
                                       placeholder="Type reply..."
                                       required>

                                <button class="btn btn-primary">
                                    Send
                                </button>

                            </div>

                        </form>

                    </div>

                    {% empty %}

                    <div class="text-center text-muted py-5">
                        No messages available
                    </div>

                    {% endfor %}

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}

