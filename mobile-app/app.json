{
  "expo": {
    "name": "Brainet Analytics",        
    "slug": "brainet-analytics-system",
    "orientation": "portrait",
    "icon": "./assets/brainet.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brainet.analytics"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brainet.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.brainet.analytics"
    }
  }
}
